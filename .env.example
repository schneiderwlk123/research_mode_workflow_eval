# 复制为 .env 后填写；不要提交真实密钥。
FULL_TRACE_AUDIT_LOG_LEVEL=INFO
FULL_TRACE_AUDIT_ARTIFACT_DIR=artifacts

# 所有 Judge 和后续 LLM 任务统一使用阿里云百炼 Batch File。
# 输入 JSONL 仅在内存中构造；任务完成后尽力删除远端输入、输出和错误文件。
# 真实密钥只填写在本地 .env，禁止提交。
BATCH_FILE_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BATCH_FILE_API_KEY=
BATCH_FILE_MODEL=qwen-plus
BATCH_FILE_COMPLETION_WINDOW=24h
BATCH_FILE_POLL_INTERVAL_SECONDS=60
BATCH_FILE_TIMEOUT_SECONDS=86400
BATCH_FILE_REQUEST_TIMEOUT_SECONDS=90
BATCH_FILE_MAX_RETRIES=2
BATCH_FILE_ENABLE_THINKING=false

# 旧版 JUDGE_API_URL/JUDGE_API_KEY/JUDGE_MODEL 仍可读取，但新配置优先使用 BATCH_FILE_*。
