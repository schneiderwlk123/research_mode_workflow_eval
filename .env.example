# 复制为 .env 后填写；不要提交真实密钥。
FULL_TRACE_AUDIT_LOG_LEVEL=INFO
FULL_TRACE_AUDIT_ARTIFACT_DIR=artifacts

# OpenAI-compatible Judge 配置。URL 填写到版本根路径，例如 https://host/v1。
# 真实密钥只填写在本地 .env，禁止提交。
JUDGE_API_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# OSS 批量导出配置(scripts/export_oss_jsonl.py)。
# OSS_ROOT_PREFIX 为 uid 文件夹上一级的日志根目录,可为空;密钥禁止提交。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ROOT_PREFIX=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
